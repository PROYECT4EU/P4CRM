    "CONSENT_REQUESTS": ["request_id", "contact_point_id", "organisation_id", "origin_interaction_id", "sender_controller_code", "target_controller_code", "channel", "destination", "status", "token_hash", "created_at", "sent_at", "expires_at", "confirmed_at", "cancelled_at", "form_id", "text_version", "privacy_version", "evidence_ref", "notes"],
    "CONSENT_REQUEST_SCOPES": ["request_scope_id", "request_id", "purpose_code", "decision", "decided_at", "consent_id", "notes"],
    "SUPPRESSIONS": ["suppression_id", "contact_point_id", "controller_code", "purpose_code", "channel", "reason", "suppressed_at", "source", "notes"],
